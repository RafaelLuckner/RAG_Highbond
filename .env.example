# Chave de autenticação (deixe vazia para uso local sem senha; defina uma senha forte no servidor)
RAG_API_KEY=

# Limite máximo de requisições por minuto por usuário/IP
RAG_RATE_LIMIT_PER_MIN=30

# Máximo de chamadas simultâneas ao Ollama (evita gargalo de CPU)
RAG_MAX_CONCURRENT=4

# Timeout máximo (segundos) esperando resposta do Ollama
OLLAMA_TIMEOUT=15

# Quantidade de perguntas recentes salvas no cache em memória (resposta em <1ms)
RAG_EMBEDDING_CACHE_SIZE=256

# URL pública do servidor (ex: https://rag.seudominio.com) para preencher o OpenAPI do ChatGPT Actions
RAG_PUBLIC_URL=

